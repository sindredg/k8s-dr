project_id             = "REPLACE_WITH_PROJECT_ID"
backup_bucket_name     = "REPLACE_WITH_GLOBALLY_UNIQUE_BACKUP_BUCKET"
backup_bucket_location = "europe-west1"

# Use user: for individual accounts, or group: for Google Groups.
admin_member           = "user:REPLACE_WITH_CLUSTER_ADMIN_EMAIL@example.com"
recovery_reader_member = "user:REPLACE_WITH_RECOVERY_READER_EMAIL@example.com"

# Worker node service account of each cluster: <name_prefix>-worker@<project>.
backup_clusters = {
  primary = "serviceAccount:REPLACE_WITH_NAME_PREFIX-worker@REPLACE_WITH_PROJECT_ID.iam.gserviceaccount.com"
}
