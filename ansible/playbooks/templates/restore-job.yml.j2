# Rendered by restore.yml. The Pod carries the backup Job's name label and
# ServiceAccount, so the backup network policies and Role apply to it: the
# restore needs the same database, metadata server, Cloud Storage, and
# Kubernetes API access, and the same scale permission on Gitea.
apiVersion: batch/v1
kind: Job
metadata:
  name: {{ restore_job }}
  namespace: {{ restore_namespace }}
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 1800
  ttlSecondsAfterFinished: 86400
  template:
    metadata:
      labels:
        app.kubernetes.io/name: gitea-backup
        app.kubernetes.io/component: restore
    spec:
      serviceAccountName: gitea-backup
      restartPolicy: Never
      # The Gitea volume is local to the worker disk.
      nodeSelector:
        node-role.kubernetes.io/worker: ""
      securityContext:
        runAsUser: 1000
        runAsGroup: 1000
        runAsNonRoot: true
        # Makes the key file readable by the restore user.
        fsGroup: 1000
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: restore
          image: {{ restore_image }}
          command: ["/backup/restore.sh"]
          env:
            - name: NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
            - name: RESTORE_SOURCE
              value: "{{ restore_source }}"
            - name: RESTORE_SET
              value: "{{ restore_set }}"
            - name: BACKUP_BUCKET
              valueFrom:
                secretKeyRef:
                  name: gitea-backup
                  key: bucket
            - name: PGHOST
              value: postgresql.{{ restore_postgresql_namespace }}.svc.cluster.local
            - name: PGUSER
              value: gitea
            - name: PGDATABASE
              value: gitea
            - name: PGPASSWORD
              valueFrom:
                secretKeyRef:
                  name: gitea-database
                  key: password
            - name: HOME
              value: /tmp
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              memory: 512Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: data
              mountPath: /data
            - name: staging
              mountPath: /staging
            - name: tmp
              mountPath: /tmp
            - name: backup
              mountPath: /backup
            - name: key
              mountPath: /restore-key
              readOnly: true
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: gitea-shared-storage
        - name: staging
          emptyDir:
            sizeLimit: 4Gi
        - name: tmp
          emptyDir:
            sizeLimit: 64Mi
        - name: backup
          configMap:
            name: gitea-backup
            defaultMode: 0555
        - name: key
          secret:
            secretName: {{ restore_key_secret }}
            defaultMode: 0440
