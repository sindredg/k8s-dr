---
apiVersion: source.toolkit.fluxcd.io/v1
kind: GitRepository
metadata:
  name: flux-system
  namespace: flux-system
spec:
  interval: 1m
  url: {{ flux_git_url }}
  ref:
    branch: {{ flux_git_branch }}
---
# wait makes this Kustomization Ready only after the Kustomizations it
# applies are Ready, including the first Gitea install. The timeout covers
# that chain.
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: flux-system
  namespace: flux-system
spec:
  interval: 10m
  sourceRef:
    kind: GitRepository
    name: flux-system
  path: ./deploy/clusters/{{ flux_cluster }}
  prune: true
  wait: true
  timeout: 15m
  decryption:
    provider: sops
    secretRef:
      name: sops-age
