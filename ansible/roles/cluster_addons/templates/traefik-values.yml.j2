---
deployment:
  replicas: 1

# The public load balancer passes 80 and 443 through unchanged, so Traefik
# binds those host ports on the worker. A surge pod could never schedule next
# to the old one, so replace the pod instead.
updateStrategy:
  type: RollingUpdate
  rollingUpdate:
    maxUnavailable: 1
    maxSurge: 0

nodeSelector:
  node-role.kubernetes.io/worker: ""

providers:
  kubernetesCRD:
    enabled: false
  kubernetesIngress:
    enabled: false
  kubernetesGateway:
    enabled: true

gateway:
  enabled: true

gatewayClass:
  enabled: true
  name: traefik

service:
  spec:
    type: NodePort

ports:
  web:
    hostPort: 80
    nodePort: {{ traefik_http_node_port }}
  websecure:
    hostPort: 443
    expose:
      default: false

api:
  dashboard: false

ingressRoute:
  dashboard:
    enabled: false

ingressClass:
  enabled: false
